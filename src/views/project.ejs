<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2><%= projectDetails.title %></h2>
        <ul>
                
                <li><%= projectDetails.description %></li>
                <li><%= projectDetails.date %></li>
                <li><%= projectDetails.location %></li>
                <li><a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></li>
                <% projectCategories.forEach(category => { %>
                    <li><a href="/categories/<%= category.category_id %>"><%= category.category_name %></a></li>
                <% }); %>
        </ul>
        <a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a>
        <a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a>
    </main>
        <%- include('partials/footer') %>